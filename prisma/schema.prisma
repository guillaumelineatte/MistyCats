generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  lastName           String?
  phone              String?
  passwordHash       String
  role               Role      @default(CUSTOMER)
  resetToken         String?   @unique
  resetTokenExpiry   DateTime?
  addresses          Address[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
}

enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id         String      @id @default(cuid())
  type       AddressType
  firstName  String
  lastName   String
  street     String
  complement String?
  postalCode String
  city       String
  country    String      @default("France")
  phone      String?
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt

  @@unique([userId, type])
}

model Article {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  image       String   @default("")
  category    String
  stock       Int      @default(0)
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
